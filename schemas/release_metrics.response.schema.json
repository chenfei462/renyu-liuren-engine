{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release metrics response",
  "type": "object",
  "required": ["metrics_id", "release_id", "session_count", "completion_rate", "feedback_count", "mode_distribution", "feedback_distribution"],
  "properties": {
    "metrics_id": {"type": "string", "const": "release_metrics.v0.1"},
    "release_id": {"type": "string"},
    "generated_at": {"type": "string"},
    "session_count": {"type": "integer"},
    "completion_count": {"type": "integer"},
    "completion_rate": {"type": "number"},
    "feedback_count": {"type": "integer"},
    "mode_distribution": {"type": "object"},
    "feedback_distribution": {"type": "object"},
    "story_or_mentor_count": {"type": "integer"},
    "safety_block_count": {"type": "integer"},
    "high_risk_trigger_count": {"type": "integer"},
    "failed_interface_count": {"type": "integer"},
    "realtime_failure_count": {"type": "integer"},
    "manual_review_count": {"type": "integer"}
  },
  "additionalProperties": true
}
