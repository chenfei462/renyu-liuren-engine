{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "productization gate response",
  "type": "object",
  "required": ["gate_id", "gate_status", "blocked_reasons"],
  "properties": {
    "gate_id": {"type": "string", "const": "productization_gate.v0.1"},
    "gate_status": {"type": "string", "enum": ["blocked", "experiment", "paused"]},
    "pause_reason": {"type": "string"},
    "blocked_reasons": {"type": "array", "items": {"type": "string"}},
    "enabled_experiments": {"type": "array", "items": {"type": "string"}},
    "public_launch_status": {"type": "string"}
  },
  "additionalProperties": true
}
