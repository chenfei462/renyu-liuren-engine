{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ops metrics response",
  "type": "object",
  "required": ["metrics_id", "ops_id", "session_count", "completion_rate", "feedback_count", "safety_block_count"],
  "properties": {
    "metrics_id": {"type": "string", "const": "ops_metrics.v0.1"},
    "ops_id": {"type": "string"},
    "generated_at": {"type": "string"},
    "session_count": {"type": "integer"},
    "completion_count": {"type": "integer"},
    "completion_rate": {"type": "number"},
    "feedback_count": {"type": "integer"},
    "mode_distribution": {"type": "object"},
    "feedback_distribution": {"type": "object"},
    "safety_block_count": {"type": "integer"},
    "api_failure_count": {"type": "integer"},
    "realtime_failure_count": {"type": "integer"},
    "share_report_count": {"type": "integer"},
    "share_report_generated_count": {"type": "integer"},
    "share_report_user_reach_count": {"type": "integer"},
    "share_report_metrics": {"type": "object"},
    "critical_event_count": {"type": "integer"}
  },
  "additionalProperties": true
}
