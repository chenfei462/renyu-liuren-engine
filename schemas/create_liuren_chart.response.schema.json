{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "create_liuren_chart response",
  "type": "object",
  "required": [
    "chart_id",
    "school_version",
    "datetime_normalized",
    "ganzhi",
    "month_general",
    "earth_plate",
    "heaven_plate",
    "four_lessons",
    "three_transmissions",
    "generals",
    "shensha",
    "safety",
    "rule_trace"
  ],
  "properties": {
    "chart_id": {"type": "string"},
    "school_version": {"type": "string"},
    "datetime_normalized": {"type": "string"},
    "ganzhi": {"type": "object"},
    "month_general": {"type": "string"},
    "earth_plate": {"type": "array", "minItems": 12, "maxItems": 12},
    "heaven_plate": {"type": "array", "minItems": 12, "maxItems": 12},
    "four_lessons": {"type": "array", "minItems": 4, "maxItems": 4},
    "three_transmissions": {"type": "array", "minItems": 3, "maxItems": 3},
    "generals": {"type": "array", "minItems": 12, "maxItems": 12},
    "shensha": {"type": "array"},
    "safety": {"type": "object"},
    "rule_trace": {
      "type": "object",
      "required": [
        "month_general_policy",
        "general_policy",
        "transmission_candidates",
        "selected_transmission_rule"
      ]
    }
  },
  "additionalProperties": true
}
