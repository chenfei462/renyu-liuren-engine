{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "expert review workflow response",
  "type": "object",
  "required": ["workflow_id", "tasks"],
  "properties": {
    "workflow_id": {"type": "string", "const": "expert_review_workflow.v0.1"},
    "phase": {"type": "string"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "rule_id", "decision", "allow_canary"],
        "properties": {
          "task_id": {"type": "string"},
          "rule_id": {"type": "string"},
          "case_ids": {"type": "array", "items": {"type": "string"}},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "current_output": {"type": "string"},
          "expert_opinion": {"type": "string"},
          "decision": {"type": "string", "enum": ["approved_for_canary", "blocked_until_reworked", "research_only"]},
          "allow_canary": {"type": "boolean"},
          "status": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
