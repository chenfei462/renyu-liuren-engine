{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "content calendar response",
  "type": "object",
  "required": ["calendar_id", "items"],
  "properties": {
    "calendar_id": {"type": "string", "const": "content_calendar.v0.1"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["content_id", "column", "title", "summary", "status"],
        "properties": {
          "content_id": {"type": "string"},
          "column": {"type": "string"},
          "title": {"type": "string"},
          "summary": {"type": "string"},
          "linked_learning_card_ids": {"type": "array", "items": {"type": "string"}},
          "linked_source_ids": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
